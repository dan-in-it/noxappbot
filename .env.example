# Discord Bot Configuration
DISCORD_BOT_TOKEN="YOUR_DISCORD_BOT_TOKEN"

# Channel Configuration
INTERVIEW_CATEGORY_ID="YOUR_INTERVIEW_CATEGORY_ID"

# Role Configuration (Optional - leave empty if not using)
OFFICER_ROLE_ID=""
ADMIN_ROLE_ID=""

# Roles granted by /noxapprove. Both must be below the bot's highest role.
# The bot also needs Manage Roles permission.
APPROVAL_ROLE_IDS="616354179522363400,1548423178794307745"

# Optional links included in the approval DM (paste Discord channel links).
WELCOME_RULES_URL=""
WELCOME_SCHEDULE_URL=""
WELCOME_INTRODUCTIONS_URL=""

# Bot Configuration
APPLICATION_CHANNEL_PREFIX="application"

# Persistent drafts, responses, decisions and cleanup deadlines.
# Relative paths resolve from the repository root.
# Keep this file on persistent storage across restarts and deployments.
APPLICATION_DB_PATH="data/applications.sqlite3"

# Logging Configuration
LOG_LEVEL="INFO"
